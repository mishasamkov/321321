<Window x:Class="Terminal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Terminal"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinHeight="450" MinWidth="800" MaxHeight="800" MaxWidth="1200">
    <Grid>
        <ListView x:Name="ParentNews">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="картинка" DisplayMemberBinding="{Binding Img}"></GridViewColumn>
                    <GridViewColumn  Header="дата" DisplayMemberBinding="{Binding Date}"></GridViewColumn>
                    <GridViewColumn   Header="тэги" DisplayMemberBinding="{Binding Badge}"></GridViewColumn>
                    <GridViewColumn    Header="текст" DisplayMemberBinding="{Binding Title}"></GridViewColumn>
                </GridView>
            </ListView.View>
           
          
        </ListView> 
        <Button Click="Get" Content="получить новости" Margin="609,391,0,0"/>
    </Grid>
</Window>
